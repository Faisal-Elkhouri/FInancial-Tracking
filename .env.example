# Copy this to .env and adjust. Docker Compose reads .env automatically.
#
#   cp .env.example .env

# --- Database (used by both dev and prod compose files) ---
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
# Dev defaults to financial_tracking_dev, prod to financial_tracking_prod.
# Override here if you want a specific name.
# DATABASE_NAME=financial_tracking_dev
# Tests use their own database and their own variable (config/test.exs ignores
# DATABASE_NAME on purpose so tests can never touch the dev/prod database).
# TEST_DATABASE_NAME=financial_tracking_test

# --- Livebook (dev) ---
# Shared Erlang cookie used by both the Phoenix node and Livebook so Livebook
# can attach to the running app. Any non-empty string; keep it consistent.
LIVEBOOK_COOKIE=financial_tracking_cookie

# --- Production only ---
# The host browsers will use to reach the app (sets the URL the app generates).
PHX_HOST=localhost
# Required in prod. Generate with: mix phx.gen.secret
# SECRET_KEY_BASE=replace-me
